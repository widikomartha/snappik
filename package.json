{
  "name": "snappik",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && tsc -p tsconfig.worker.json",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/main.ts",
    "worker:start": "node --env-file-if-exists=.env.local dist/worker/main.js",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/database.test.ts tests/onboarding.test.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:auth": "tsx --test --test-concurrency=1 tests/auth.test.ts",
    "test:recovery": "tsx --test --test-concurrency=1 tests/recovery.test.ts",
    "auth:recovery:drain": "tsx --env-file-if-exists=.env.local src/modules/auth/recovery-drain-cli.ts",
    "test:auth:smoke": "tsx scripts/auth-smoke.ts",
    "db:auth:migrate": "tsx --env-file-if-exists=.env.local src/db/auth-migrate-cli.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "check": "npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "dependencies": {
    "better-auth": "1.7.9",
    "kysely": "0.29.6",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
