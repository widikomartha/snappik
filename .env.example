APP_ORIGIN=http://localhost:3000
# Synthetic loopback database ONLY; db:local creates this dedicated cluster.
DATABASE_URL=postgresql://snappik_local:synthetic_local_only@127.0.0.1:55433/snappik_local
MIGRATION_DATABASE_URL=postgresql://snappik_local:synthetic_local_only@127.0.0.1:55433/snappik_local
AUTH_MODE=unconfigured
# Explicit loopback-only validation mode: better-auth-local. Requires reviewed
# app + auth migrations, stable AUTH_INSTANCE_ID and generated BETTER_AUTH_SECRET.
# No public signup, recovery mail, OAuth or production mode is enabled.
# Optional AUTH_RECOVERY_KEY: separate generated 32-byte base64url server key (43 chars).
# Enables local durable recovery/reset only; no external delivery. Keep stable across restarts.
# auth:recovery:drain discards a bounded synthetic batch; it never prints tokens or sends email.
DRIVE_MODE=unconfigured
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
DB_POOL_MAX=5
